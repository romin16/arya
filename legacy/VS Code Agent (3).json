      "id": "e5787333-e966-40e4-ae2c-809829b1845e",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "jsCode": "// Extract the user's request\nconst input = $input.first().json;\nconst userRequest = input.query || input.user_request || input.message || input.text || JSON.stringify(input);\n\nconsole.log('[VSCode] Raw input:', JSON.stringify(input));\nconsole.log('[VSCode] User request:', userRequest);\n\nconst request = userRequest.toLowerCase();\n\nlet action = 'open'; // Default\nlet folder = null;\nlet file = null;\nlet searchTerm = null;\nlet command = null;\n\n// Detect action type\nif (request.includes('search') || request.includes('find')) {\n  action = 'search';\n  // Extract search term\n  const searchMatch = userRequest.match(/(?:search|find)\\s+(?:for\\s+)?[\"']?([^\"']+)[\"']?/i);\n  if (searchMatch) {\n    searchTerm = searchMatch[1].trim();\n  }\n}\nelse if (request.includes('run') || request.includes('execute') || request.includes('terminal')) {\n  action = 'run_command';\n  // Extract command\n  const cmdMatch = userRequest.match(/(?:run|execute)\\s+[\"']?([^\"']+)[\"']?/i);\n  if (cmdMatch) {\n    command = cmdMatch[1].trim();\n  }\n}\nelse if (request.includes('open file') || request.includes('open') && (request.includes('.py') || request.includes('.js') || request.includes('.txt'))) {\n  action = 'open_file';\n  // Extract filename\n  const fileMatch = userRequest.match(/([a-zA-Z0-9_-]+\\.[a-z]{2,4})/i);\n  if (fileMatch) {\n    file = fileMatch[1];\n  }\n}\nelse if (request.includes('format')) {\n  action = 'format';\n}\nelse {\n  // Default: just open VS Code\n  action = 'open';\n  // Try to extract folder path\n  const folderMatch = userRequest.match(/([A-Z]:\\\\[^\\s]+|\\/?[a-z_-]+(?:\\/[a-z_-]+)*)/i);\n  if (folderMatch) {\n    folder = folderMatch[1];\n  }\n}\n\nconst result = { \n  action,\n  folder,\n  file,\n  searchTerm,\n  command\n};\n\nconsole.log('[VSCode] Parsed:', JSON.stringify(result));\n\nreturn result;"
      },
