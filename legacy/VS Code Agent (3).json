        "jsCode": "// Format the response for the main agent\nconst input = $input.first().json;\n\nlet response;\n\nif (input.success) {\n  response = input.message || 'VS Code action completed successfully';\n} else {\n  response = `VS Code error: ${input.error || 'Unknown error'}`;\n}\n\nconsole.log('[VSCode] Response:', response);\n\nreturn { result: response };"
