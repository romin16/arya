{
  "name": "Desktop Agent - Apps & System",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "ecda6fc0-173e-4818-bece-a46082eade70",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        3216,
        3664
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst userRequest = String(input.query || input.user_request || input.message || JSON.stringify(input));\nconst request = userRequest.toLowerCase();\n\nlet action, app_name, level, text;\n\nif (request.includes('volume') || request.includes('sound')) {\n  action = 'system_volume';\n  const match = request.match(/(\\d+)/);\n  level = match ? parseInt(match[1]) : 50;\n}\nelse if (request.includes('type ') || request.match(/^type /)) {\n  action = 'type_text';\n  text = userRequest.replace(/^type\\s+/i, '').trim();\n}\nelse if (request.includes('close') || request.includes('quit') || request.includes('exit')) {\n  action = 'close_app';\n  const apps = ['chrome','spotify','vscode','vs code','visual studio','calculator','notepad','discord','whatsapp','explorer','firefox','edge'];\n  for (const app of apps) {\n    if (request.includes(app)) {\n      app_name = (app === 'vs code' || app === 'visual studio') ? 'vscode' : app;\n      break;\n    }\n  }\n}\nelse if (request.includes('open') || request.includes('launch') || request.includes('start')) {\n  action = 'open_app';\n  const apps = ['chrome','spotify','vscode','vs code','visual studio','calculator','notepad','discord','whatsapp','explorer','firefox','edge'];\n  for (const app of apps) {\n    if (request.includes(app)) {\n      app_name = (app === 'vs code' || app === 'visual studio') ? 'vscode' : app;\n      break;\n    }\n  }\n}\nelse {\n  action = 'unknown';\n}\n\nconsole.log('[Desktop] Action:', action, '| App:', app_name, '| Level:', level);\nreturn { action, app_name, level, text, original_request: userRequest };"
      },
      "id": "c6c1b547-bce9-4b6a-a46a-876cb2dd0bb6",
